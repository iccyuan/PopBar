<Window x:Class="PopBar.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PopBar"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <!-- Glass frame everywhere: the client area becomes transparent so the DWM acrylic backdrop shows through. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="BarBrush" Color="#A6232833"/>
        <SolidColorBrush x:Key="BarEdgeBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="BarFgBrush" Color="#F1F3F7"/>
        <SolidColorBrush x:Key="BarHoverBrush" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="BarPressedBrush" Color="#45FFFFFF"/>
        <SolidColorBrush x:Key="BarSepBrush" Color="#22FFFFFF"/>

        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource BarFgBrush}"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <!-- declared inline (not frozen) so the hover ColorAnimation can run -->
                                <SolidColorBrush Color="#00FFFFFF"/>
                            </Border.Background>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background.Color" To="#2EFFFFFF" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background.Color" To="#00FFFFFF" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Opacity="0" RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="Zoom" ScaleX="0.96" ScaleY="0.96"/>
                <TranslateTransform x:Name="Slide"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Border x:Name="Bar" Background="{DynamicResource BarBrush}" CornerRadius="10" Padding="5,4">
            <StackPanel x:Name="Buttons" Orientation="Horizontal"/>
        </Border>
    </Grid>
</Window>
