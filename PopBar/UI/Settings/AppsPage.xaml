<ui:SettingsPage x:Class="PopBar.UI.AppsPage" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PopBar.UI">
    <StackPanel>
        <TextBlock Style="{StaticResource H2}" Text="排除的应用" Margin="4,0,0,8"/>
        <Border Style="{StaticResource Card}" Padding="18,14">
            <StackPanel>
                <TextBlock Style="{StaticResource Muted}" Text="这些程序里不弹出操作条。" Margin="0,0,0,10"/>
                <StackPanel x:Name="ExcludedList"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <ComboBox x:Name="ExcludedPick" Width="320" DisplayMemberPath="Label" SelectedValuePath="Exe" DropDownOpened="ProcessPick_Opened"/>
                    <Button Content="添加" Margin="8,0,0,0" Click="AddExcluded_Click"/>
                    <Button Content="浏览" Margin="8,0,0,0" Click="BrowseExcluded_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource H2}" Text="不模拟 Ctrl+C 复制的应用"/>
        <Border Style="{StaticResource Card}" Padding="18,14">
            <StackPanel>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="有的程序读不到选中的文字，PopBar 会替你按一下 Ctrl+C 复制出来（之后把剪贴板还原）。如果某个程序里 Ctrl+C 有别的作用、被这样一按会出问题，就把它加到这里。终端、远程桌面和虚拟机已自动排除，不用添加。"/>
                <StackPanel x:Name="NoClipList"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <ComboBox x:Name="NoClipPick" Width="320" DisplayMemberPath="Label" SelectedValuePath="Exe" DropDownOpened="ProcessPick_Opened"/>
                    <Button Content="添加" Margin="8,0,0,0" Click="AddNoClip_Click"/>
                    <Button Content="浏览" Margin="8,0,0,0" Click="BrowseNoClip_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</ui:SettingsPage>
