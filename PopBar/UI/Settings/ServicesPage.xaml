<ui:SettingsPage x:Class="PopBar.UI.ServicesPage" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PopBar.UI">
    <StackPanel>
        <DockPanel Margin="0,0,0,12">
            <Button x:Name="AddLlmButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="＋ 添加服务商" VerticalAlignment="Center" Click="AddLlm_Click"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource H2}" Text="AI 模型" Margin="4,0,0,0" VerticalAlignment="Center"/>
                <ui:InfoTip Text="可以同时配置多家服务商，各家的地址、密钥、模型分别保存。AI 助手、翻译等插件默认用标了「默认」的那家，也可以在各自设置里另选。OpenAI：任何兼容 /chat/completions 的接口都行"/>
            </StackPanel>
        </DockPanel>
        <!-- one row per configured service (built in code); click a row to edit it in the card below -->
        <StackPanel x:Name="LlmServiceList"/>
        <TextBlock x:Name="LlmEmptyHint" Style="{StaticResource Muted}" Margin="4,0,0,8" TextWrapping="Wrap"
                   Text="还没有配置服务商。点「添加服务商」选一家，填好地址、密钥和模型；可以添加多家，再指定一家为默认。"/>
        <StackPanel x:Name="LlmFormHeader" Orientation="Horizontal" Margin="4,10,0,8">
            <ui:IconImage x:Name="LlmFormLogo" Icon="bot" Size="16" Brush="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="LlmFormName" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
        </StackPanel>
        <Border x:Name="LlmFormCard" Style="{StaticResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,12,8">
                        <TextBlock Text="设为默认" VerticalAlignment="Center"/>
                        <ui:InfoTip Text="AI 助手、翻译等插件没有另选服务商时用这一家"/>
                    </StackPanel>
                    <CheckBox x:Name="LlmDefaultSw" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Checked="LlmDefault_Changed" Unchecked="LlmDefault_Changed"/>
                </Grid>
                <Rectangle Style="{StaticResource RowSep}"/>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,12,8">
                        <TextBlock Text="接口地址" VerticalAlignment="Center"/>
                        <ui:InfoTip Text="填到 /v1 为止；Anthropic 留空即官方"/>
                        </StackPanel>
                    <TextBox x:Name="LlmBaseUrlBox" Grid.Column="1" Width="330" VerticalAlignment="Center" TextChanged="Llm_Changed"/>
                </Grid>
                <Rectangle Style="{StaticResource RowSep}"/>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="API Key" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- masked by default; the eye swaps in a plain TextBox bound to the same value -->
                        <Grid Width="290">
                            <PasswordBox x:Name="LlmKeyBox" PasswordChanged="Llm_Changed"/>
                            <TextBox x:Name="LlmKeyPlain" Visibility="Collapsed" TextChanged="LlmKeyPlain_TextChanged"/>
                        </Grid>
                        <Button x:Name="LlmKeyEye" Style="{StaticResource IconButton}" Width="34" Height="34" Margin="6,0,0,0" ToolTip="显示 API Key" Click="LlmKeyEye_Click">
                            <ui:IconImage x:Name="LlmKeyEyeIcon" Icon="eye" Size="16" Brush="{DynamicResource MutedBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <Rectangle Style="{StaticResource RowSep}"/>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,12,8">
                        <TextBlock Text="默认模型" VerticalAlignment="Center"/>
                        <ui:InfoTip Text="各插件可在自己的设置里另选模型"/>
                        </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="LlmModelBox" Width="236" IsEditable="True" SelectionChanged="Llm_Changed"/>
                            <Button x:Name="FetchModelsButton" Content="获取模型" Margin="8,0,0,0" Click="FetchModels_Click"/>
                        </StackPanel>
                        <!-- what this protocol can do with the model: right under it, not above the whole card -->
                        <WrapPanel x:Name="LlmFeatureChips" Margin="0,8,0,2" MaxWidth="330" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
                <Rectangle x:Name="LlmThinkingSep" Style="{StaticResource RowSep}"/>
                <Grid x:Name="LlmThinkingRow" Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,12,8">
                        <TextBlock Text="深度思考" VerticalAlignment="Center"/>
                        <ui:InfoTip Text="先推理再回答，更准但更慢、更费 token；AI 助手的思考过程显示在答案上方，可收起。翻译总是不思考"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="LlmEffortCombo" Width="150" Margin="0,0,14,0" VerticalAlignment="Center" ToolTip="思考深度"
                                  DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Llm_Changed"/>
                        <CheckBox x:Name="LlmThinkingSw" Style="{StaticResource Switch}" VerticalAlignment="Center" Checked="Llm_Changed" Unchecked="Llm_Changed"/>
                    </StackPanel>
                </Grid>
                <Rectangle Style="{StaticResource RowSep}"/>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LlmTestResult" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,8,12,8" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" Content="测试连接" VerticalAlignment="Center" Click="LlmTest_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</ui:SettingsPage>
