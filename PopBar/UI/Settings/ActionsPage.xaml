<ui:SettingsPage x:Class="PopBar.UI.ActionsPage" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PopBar.UI">
    <StackPanel>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="恢复默认" Click="ResetActions_Click" Margin="0,0,8,0"/>
                <Button Style="{StaticResource AccentButton}" Content="＋ 添加动作" Click="AddAction_Click"/>
            </StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="操作条上的动作" Margin="4,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>

        <ListBox x:Name="ActionsList" Style="{StaticResource PlainList}" AllowDrop="True" DragOver="ActionsList_DragOver" Drop="ActionsList_Drop">
            <ListBox.Resources>
                <BooleanToVisibilityConverter x:Key="BoolVis"/>
                <!-- a stand-alone action -->
                <DataTemplate DataType="{x:Type ui:ActionRow}">
                    <Border Style="{StaticResource Card}" Padding="6,10,14,10" Opacity="{Binding DragOpacity}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="24" Height="36" Background="Transparent" Cursor="SizeAll" ToolTip="拖动排序" VerticalAlignment="Center" Margin="0,0,6,0" PreviewMouseLeftButtonDown="DragHandle_MouseDown">
                                <ui:IconImage Icon="grip-vertical" Size="16" Brush="{DynamicResource MutedBrush}"/>
                            </Border>
                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                <ui:IconImage Icon="{Binding Def.Icon}" Size="18" Brush="{DynamicResource AccentHoverBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" FontSize="14"/>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                <Button Style="{StaticResource IconButton}" ToolTip="{Binding EditTip}" Click="EditAction_Click">
                                    <ui:IconImage Icon="pencil" Size="14" Brush="{DynamicResource MutedBrush}"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" ToolTip="删除" Click="DeleteAction_Click">
                                    <ui:IconImage Icon="trash" Size="14" Brush="{DynamicResource DangerBrush}"/>
                                </Button>
                            </StackPanel>
                            <CheckBox Grid.Column="4" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                        </Grid>
                    </Border>
                </DataTemplate>

                <!-- several actions of one plugin: one card, plugin header, members hanging off a guide line -->
                <DataTemplate DataType="{x:Type ui:ActionGroupRow}">
                    <Border Style="{StaticResource Card}" Padding="6,10,14,8" Opacity="{Binding DragOpacity}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="36" Background="Transparent" Cursor="SizeAll" ToolTip="拖动整组排序" VerticalAlignment="Center" Margin="0,0,6,0" PreviewMouseLeftButtonDown="DragHandle_MouseDown">
                                    <ui:IconImage Icon="grip-vertical" Size="16" Brush="{DynamicResource MutedBrush}"/>
                                </Border>
                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                                    <ui:IconImage Icon="{Binding Icon}" Size="18" Brush="White"/>
                                </Border>
                                <!-- the whole title area folds / unfolds the group, like the chevron -->
                                <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="GroupToggle_Click">
                                    <TextBlock Text="{Binding Name}" FontSize="14"/>
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                                <!-- count + expander sit at the right, where plain rows keep their switch -->
                                <Border Grid.Column="3" CornerRadius="10" Padding="9,2,9,3" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource AccentHoverBrush}"/>
                                </Border>
                                <Button Grid.Column="4" Style="{StaticResource IconButton}" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="收起 / 展开" Click="GroupToggle_Click">
                                    <ui:IconImage Icon="{Binding ChevronIcon}" Size="16" Brush="{DynamicResource MutedBrush}"/>
                                </Button>
                            </Grid>
                            <!-- guide line under the plugin icon ties the members to it -->
                            <Border Margin="47,6,0,0" BorderThickness="2,0,0,0" BorderBrush="{DynamicResource AccentSoftBrush}"
                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                                <ItemsControl ItemsSource="{Binding Members}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4,0,4" Opacity="{Binding DragOpacity}" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="0" Width="12" Height="2" Fill="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Width="20" Height="32" Background="Transparent" Cursor="SizeAll" ToolTip="在组内拖动排序" VerticalAlignment="Center" Margin="2,0,2,0" PreviewMouseLeftButtonDown="DragHandle_MouseDown">
                                                    <ui:IconImage Icon="grip-vertical" Size="14" Brush="{DynamicResource MutedBrush}"/>
                                                </Border>
                                                <Border Grid.Column="2" Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                                    <ui:IconImage Icon="{Binding Def.Icon}" Size="15" Brush="{DynamicResource AccentHoverBrush}"/>
                                                </Border>
                                                <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}"/>
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                    <Button Style="{StaticResource IconButton}" ToolTip="{Binding EditTip}" Click="EditAction_Click">
                                                        <ui:IconImage Icon="pencil" Size="14" Brush="{DynamicResource MutedBrush}"/>
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" ToolTip="删除" Click="DeleteAction_Click">
                                                        <ui:IconImage Icon="trash" Size="14" Brush="{DynamicResource DangerBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                                <CheckBox Grid.Column="5" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.Resources>
        </ListBox>
    </StackPanel>
</ui:SettingsPage>
