<ui:SettingsPage x:Class="PopBar.UI.ProxyPage" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PopBar.UI">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,12,8">
                        <TextBlock Text="代理服务器" VerticalAlignment="Center"/>
                        <ui:InfoTip Text="插件和 AI 服务选「使用代理」时走这里；端口没填时用系统代理。Clash、v2rayN 等一般是 127.0.0.1 加它们的 HTTP 或 SOCKS5 端口。"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="SchemeCombo" Width="100" VerticalAlignment="Center" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Field_Changed"/>
                        <TextBox x:Name="HostBox" Width="150" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="主机，本机一般是 127.0.0.1" TextChanged="Field_Changed"/>
                        <TextBlock Text=":" Margin="6,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBox x:Name="PortBox" Width="70" VerticalAlignment="Center" ToolTip="端口，如 7890" TextChanged="Field_Changed" PreviewTextInput="Port_PreviewTextInput"/>
                        <Button x:Name="TestButton" Content="测试" Margin="8,0,0,0" VerticalAlignment="Center" Click="Test_Click"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="TestResult" Style="{StaticResource Muted}" Margin="0,-4,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>
                <Rectangle Style="{StaticResource RowSep}"/>
                <Grid Style="{StaticResource Row}">
                    <TextBlock Text="需要认证" VerticalAlignment="Center"/>
                    <CheckBox x:Name="AuthSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Auth_Changed" Unchecked="Auth_Changed"/>
                </Grid>
                <Grid x:Name="AuthRow" Style="{StaticResource Row}" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="用户名 / 密码" VerticalAlignment="Center" Margin="0,8,12,8"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="UserBox" Width="150" VerticalAlignment="Center" ToolTip="用户名" TextChanged="Field_Changed"/>
                        <PasswordBox x:Name="PasswordBox" Width="150" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="密码（加密保存）" PasswordChanged="Field_Changed"/>
                    </StackPanel>
                </Grid>
                <Rectangle Style="{StaticResource RowSep}"/>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,12,8">
                        <TextBlock Text="PopBar 联网方式" VerticalAlignment="Center"/>
                        <ui:InfoTip Text="PopBar 自己的请求（更新模型目录、安装插件），以及选了「跟随主程序」的插件和 AI 服务。本机和局域网地址（如本机 Ollama）始终直连。"/>
                    </StackPanel>
                    <ComboBox x:Name="ModeCombo" Grid.Column="1" Width="160" VerticalAlignment="Center"
                              DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Changed"/>
                </Grid>
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Muted}" Margin="4,10,0,0" TextWrapping="Wrap"
                   Text="插件在自己的设置里选择「跟随主程序 / 不使用代理 / 使用代理」；AI 服务在「服务」页每家服务商的设置里选择。"/>
    </StackPanel>
</ui:SettingsPage>
