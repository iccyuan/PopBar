<Window x:Class="PopBar.UI.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PopBar.UI"
        Title="PopBar Panel"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        ResizeMode="NoResize" SizeToContent="Height" Width="440"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Animated"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PBg" Color="#CCFFFFFF"/>
        <SolidColorBrush x:Key="PBorder" Color="#22000000"/>
        <SolidColorBrush x:Key="PFg" Color="#1F2937"/>
        <SolidColorBrush x:Key="PMuted" Color="#6B7280"/>
        <SolidColorBrush x:Key="PHover" Color="#14000000"/>
        <SolidColorBrush x:Key="PSource" Color="#12000000"/>
        <SolidColorBrush x:Key="PAccent" Color="#3B82F6"/>

        <!-- Body scrollers: keep the text clear of the overlay scrollbar, but only while the bar is actually shown. -->
        <Style x:Key="PBodyScroll" TargetType="ScrollViewer">
            <Style.Triggers>
                <Trigger Property="ComputedVerticalScrollBarVisibility" Value="Visible">
                    <Setter Property="Padding" Value="0,0,12,0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PIconBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PFooterBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource PFg}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource PSource}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="14" RenderOptions.ClearTypeHint="Enabled">
        <!-- shadow caster: hidden under the opaque glass snapshot, only its shadow shows -->
        <Border x:Name="Shadow" CornerRadius="12" Background="#FF1E232D">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.2" Color="#000000"/>
            </Border.Effect>
        </Border>
        <Border x:Name="Glass" CornerRadius="12"/>
    <Border x:Name="Shell" Background="{DynamicResource PBg}" CornerRadius="12">
        <DockPanel>
            <!-- title bar -->
            <Grid DockPanel.Dock="Top" x:Name="TitleBar" Height="42" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:IconImage x:Name="TitleIcon" Size="17" Brush="{DynamicResource PAccent}" Margin="16,0,8,0" VerticalAlignment="Center"/>
                <DockPanel Grid.Column="1" VerticalAlignment="Center" LastChildFill="False">
                    <TextBlock x:Name="TitleText" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PFg}" TextTrimming="CharacterEllipsis"/>
                    <!-- who produced the result (translation provider, model...) -->
                    <Border x:Name="BadgeBox" DockPanel.Dock="Left" Margin="8,0,0,0" Padding="8,1,8,2" CornerRadius="9" Background="{DynamicResource PSource}" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="BadgeText" FontSize="11.5" Foreground="{DynamicResource PMuted}" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                    </Border>
                </DockPanel>
                <!-- busy indicator: faint track with a gradient "comet" sweeping across (animated from code) -->
                <Grid x:Name="BusyTrack" Grid.ColumnSpan="3" Height="2" VerticalAlignment="Bottom" Margin="16,0,16,0" ClipToBounds="True" Opacity="0" IsHitTestVisible="False" SizeChanged="BusyTrack_SizeChanged">
                    <Border CornerRadius="1" Background="{DynamicResource PAccent}" Opacity="0.18"/>
                    <Border x:Name="BusyComet" HorizontalAlignment="Left" Width="160" CornerRadius="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#003B82F6" Offset="0"/>
                                <GradientStop Color="#FF3B82F6" Offset="0.45"/>
                                <GradientStop Color="#FF3B82F6" Offset="0.7"/>
                                <GradientStop Color="#003B82F6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="BusyX" X="-160"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button x:Name="PinBtn" Style="{StaticResource PIconBtn}" ToolTip="固定（点击外部不关闭）" Click="Pin_Click">
                        <ui:IconImage x:Name="PinIcon" Icon="pin" Size="14" Brush="{DynamicResource PMuted}"/>
                    </Button>
                    <Button Style="{StaticResource PIconBtn}" ToolTip="关闭 (Esc)" Click="Close_Click">
                        <ui:IconImage Icon="x" Size="13" Brush="{DynamicResource PMuted}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- footer -->
            <Grid DockPanel.Dock="Bottom" Margin="16,8,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource PMuted}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                <StackPanel x:Name="FooterButtons" Grid.Column="1" Orientation="Horizontal"/>
            </Grid>

            <!-- body -->
            <StackPanel Margin="16,0,16,0">
                <!-- source text: three lines with an ellipsis by default; 「显示全部」 appears only when it was cut -->
                <Border x:Name="SourceBox" CornerRadius="8" Background="{DynamicResource PSource}" Padding="10,6" Margin="0,0,0,10" Visibility="Collapsed">
                    <StackPanel>
                        <ScrollViewer x:Name="SourceScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource PBodyScroll}">
                            <TextBlock x:Name="SourceText" FontSize="12" Foreground="{DynamicResource PMuted}" TextTrimming="CharacterEllipsis" MaxHeight="52" TextWrapping="Wrap"/>
                        </ScrollViewer>
                        <!-- icon-only toggle: a round chip with a double chevron, accent on hover, tooltip spells it out -->
                        <Button x:Name="SourceExpandBtn" Visibility="Collapsed" Click="SourceExpand_Click" HorizontalAlignment="Right" Margin="0,4,-4,-2"
                                Cursor="Hand" Focusable="False" Width="24" Height="24" ToolTip="显示全部" Tag="chevrons-down">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="12" Background="{DynamicResource PHover}">
                                        <ui:IconImage x:Name="Ic" Icon="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Size="15" Brush="{DynamicResource PAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PAccent}"/>
                                            <Setter TargetName="Ic" Property="Brush" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
                <ContentControl x:Name="CustomHost" Visibility="Collapsed" Focusable="False"/>
                <Grid x:Name="TextArea">
                    <TextBox x:Name="ResultBox" MinHeight="60" MaxHeight="420" FontSize="13.5"
                             Background="Transparent" BorderThickness="0" Padding="0" Foreground="{DynamicResource PFg}"
                             CaretBrush="{DynamicResource PFg}" SelectionBrush="{DynamicResource PAccent}"
                             TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" TextChanged="ResultBox_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Style="{StaticResource PBodyScroll}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
                <!-- failures stand out instead of hiding in the grey status line -->
                <Border x:Name="ErrorBox" CornerRadius="8" Background="{DynamicResource PErrBg}" Padding="10,8" Margin="0,4,0,2" Visibility="Collapsed">
                    <DockPanel>
                        <ui:IconImage Icon="circle-alert" Size="15" Brush="{DynamicResource PErrFg}" VerticalAlignment="Top" Margin="0,1,8,0"/>
                        <TextBox x:Name="ErrorText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"
                                 FontSize="12.5" Foreground="{DynamicResource PErrFg}" SelectionBrush="{DynamicResource PAccent}">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"/>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </DockPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
    </Grid>
</Window>
