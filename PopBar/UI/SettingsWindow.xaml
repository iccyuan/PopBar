<Window x:Class="PopBar.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PopBar.UI"
        Title="PopBar 设置" Icon="{x:Static ui:LogoArt.WindowIcon}" Width="880" Height="660" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Animated">
    <!-- Glass frame over the whole window so Mica shows through; DWM still draws the caption buttons. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- nav (its top 44px doubles as the draggable title area) -->
        <Border Grid.Column="0" Background="{DynamicResource NavBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" RenderOptions.ClearTypeHint="Enabled">
            <DockPanel Margin="12,44,12,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,22">
                    <Image Source="{x:Static ui:LogoArt.Image}" Width="34" Height="34" VerticalAlignment="Center"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PopBar" FontSize="17" FontWeight="Bold"/>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Content="通用" Tag="sliders" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavActions" Style="{StaticResource NavItem}" Content="动作" Tag="zap" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" Content="应用" Tag="app-window" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavPlugins" Style="{StaticResource NavItem}" Content="插件" Tag="puzzle" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavServices" Style="{StaticResource NavItem}" Content="服务" Tag="server" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Content="关于" Tag="info" Checked="Nav_Checked"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Style="{StaticResource Muted}" Margin="10,0,0,0" Text=""/>
            </DockPanel>
        </Border>

        <!-- window title drawn by us (DWM only draws the caption buttons when the frame is extended) -->
        <TextBlock Grid.Column="0" Text="PopBar 设置" Style="{StaticResource Muted}" Margin="22,13,0,0" VerticalAlignment="Top" IsHitTestVisible="False"/>

        <!-- content -->
        <!-- Spacing lives on the content, not the ScrollViewer: its padding would clip scrolled cards at a hard line. -->
        <!-- one tint over the whole right column, title strip included, so it reads as a single surface -->
        <Border Grid.Column="1" Background="{DynamicResource ContentBgBrush}"/>
        <ScrollViewer x:Name="ContentScroll" Grid.Column="1" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" Margin="0,44,0,0">
            <Grid x:Name="ContentRoot" Margin="32,12,32,32">
                <!-- ===== General ===== -->
                <ui:GeneralPage x:Name="PanelGeneral"/>

                <!-- ===== Apps ===== -->
                <ui:AppsPage x:Name="PanelApps" Visibility="Collapsed"/>

                <!-- ===== Actions ===== -->
                <ui:ActionsPage x:Name="PanelActions" Visibility="Collapsed"/>

                <!-- ===== Plugins ===== -->
                <ui:PluginsPage x:Name="PanelPlugins" Visibility="Collapsed"/>

                <!-- ===== Services: capabilities shared by plugins ===== -->
                <ui:ServicesPage x:Name="PanelServices" Visibility="Collapsed"/>

                <!-- ===== About ===== -->
                <ui:AboutPage x:Name="PanelAbout" Visibility="Collapsed"/>
            </Grid>
        </ScrollViewer>

        <!-- unsaved-changes bar: nothing is written until the user saves -->
        <Border x:Name="SaveBar" Grid.Column="1" VerticalAlignment="Bottom" Margin="32,0,40,20" CornerRadius="14"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Visibility="Collapsed" SizeChanged="SaveBar_SizeChanged">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.1"/>
            </Border.Effect>
            <Grid>
                <!-- frosted glass: the page content under the bar, blurred live, under a translucent card tint -->
                <Border x:Name="SaveBarGlass" CornerRadius="13">
                    <Rectangle x:Name="SaveBarGlassImage" Margin="-40" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <!-- Fill with viewbox and rectangle of equal size = a 1:1 copy; Stretch=None would draw the whole visual instead -->
                            <VisualBrush x:Name="SaveBarGlassBrush" ViewboxUnits="Absolute" Stretch="Fill" ViewportUnits="RelativeToBoundingBox" Viewport="0,0,1,1"/>
                        </Rectangle.Fill>
                        <Rectangle.Effect>
                            <BlurEffect Radius="36" KernelType="Gaussian" RenderingBias="Performance"/>
                        </Rectangle.Effect>
                    </Rectangle>
                </Border>
                <Border CornerRadius="13" Background="{DynamicResource CardBrush}" Opacity="0.6"/>
            <DockPanel Margin="18,10,10,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="取消" Click="CancelChanges_Click" ToolTip="放弃改动，恢复到上次保存"/>
                    <Button Style="{StaticResource AccentButton}" Content="保存" Margin="8,0,0,0" Click="SaveChanges_Click" ToolTip="Ctrl+S"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="有未保存的更改" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
