<Window x:Class="PopBar.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PopBar.UI"
        Title="PopBar 设置" Width="880" Height="660" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <!-- Glass frame over the whole window so Mica shows through; DWM still draws the caption buttons. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- nav (its top 44px doubles as the draggable title area) -->
        <Border Grid.Column="0" Background="{DynamicResource NavBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" RenderOptions.ClearTypeHint="Enabled">
            <DockPanel Margin="12,44,12,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,22">
                    <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ui:IconImage Icon="mouse-pointer" Size="17" Brush="White"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PopBar" FontSize="17" FontWeight="Bold"/>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Text="v0.2.0" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Content="通用" Tag="sliders" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavActions" Style="{StaticResource NavItem}" Content="动作" Tag="zap" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" Content="应用" Tag="app-window" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavPlugins" Style="{StaticResource NavItem}" Content="插件" Tag="puzzle" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Content="关于" Tag="info" Checked="Nav_Checked"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Style="{StaticResource Muted}" Margin="10,0,0,0" Text=""/>
            </DockPanel>
        </Border>

        <!-- window title drawn by us (DWM only draws the caption buttons when the frame is extended) -->
        <TextBlock Grid.Column="0" Text="PopBar 设置" Style="{StaticResource Muted}" Margin="22,13,0,0" VerticalAlignment="Top" IsHitTestVisible="False"/>

        <!-- content -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="32,26,32,32" Margin="0,44,0,0">
            <Grid>
                <!-- ===== General ===== -->
                <StackPanel x:Name="PanelGeneral">
                    <TextBlock Style="{StaticResource H1}" Text="通用"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="启用 PopBar"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="关闭后不再监听选择，托盘菜单也可切换"/>
                                </StackPanel>
                                <CheckBox x:Name="EnabledSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="开机自动启动" VerticalAlignment="Center"/>
                                <CheckBox x:Name="AutoStartSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource H2}" Text="触发方式"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="显示方式"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="“按键后显示”：选中时按住该键，或选中后 4 秒内按一下，操作条才出现"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox x:Name="ShowModeCombo" Width="150" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="ShowMode_Changed"/>
                                    <ComboBox x:Name="ShowKeyCombo" Width="90" Margin="8,0,0,0" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Changed"/>
                                </StackPanel>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="鼠标拖动选择文本" VerticalAlignment="Center"/>
                                <CheckBox x:Name="DragSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="双击 / 三击选中" VerticalAlignment="Center"/>
                                <CheckBox x:Name="DblSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Shift + 点击扩展选择" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ShiftSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource H2}" Text="取词"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="剪贴板回退"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="UI Automation 读不到选区时，模拟 Ctrl+C 取词并立即恢复剪贴板。终端类程序永远不用此方式。"/>
                                </StackPanel>
                                <ComboBox x:Name="FallbackCombo" Grid.Column="1" Width="230" VerticalAlignment="Center"
                                          DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="弹出延迟（毫秒）"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="松开鼠标后等待多久再取词，太小可能取到上一次的选区"/>
                                </StackPanel>
                                <TextBox x:Name="DelayBox" Width="90" HorizontalAlignment="Right" VerticalAlignment="Center" TextChanged="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="最大文本长度（超过不弹出）" VerticalAlignment="Center"/>
                                <TextBox x:Name="MaxLenBox" Width="90" HorizontalAlignment="Right" VerticalAlignment="Center" TextChanged="Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource H2}" Text="外观"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="主题"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="作用于操作条、面板和本窗口；跟随系统时随 Windows 深浅色实时切换"/>
                                </StackPanel>
                                <ComboBox x:Name="ThemeCombo" Width="160" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="按钮显示文字标签" VerticalAlignment="Center"/>
                                <CheckBox x:Name="LabelsSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="毛玻璃不透明度"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="操作条和面板底色的实度，越低越透、越容易发灰"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="BlurSlider" Width="180" Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="BlurSlider_ValueChanged"/>
                                    <TextBlock x:Name="BlurValueText" Width="40" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ===== Apps ===== -->
                <StackPanel x:Name="PanelApps" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="应用"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="4,0,0,12" Text="从正在运行的程序里选，或浏览选择 exe 文件；按进程名匹配。"/>

                    <TextBlock Style="{StaticResource H2}" Text="排除的应用" Margin="4,0,0,8"/>
                    <Border Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Text="PopBar 在这些程序里完全不弹出（游戏、设计软件、远程桌面等）" Margin="0,0,0,10"/>
                            <StackPanel x:Name="ExcludedList"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ComboBox x:Name="ExcludedPick" Width="320" DisplayMemberPath="Label" SelectedValuePath="Exe" DropDownOpened="ProcessPick_Opened"/>
                                <Button Content="添加" Margin="8,0,0,0" Click="AddExcluded_Click"/>
                                <Button Content="浏览 exe…" Margin="8,0,0,0" Click="BrowseExcluded_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource H2}" Text="禁用剪贴板回退的应用"/>
                    <Border Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Text="Ctrl+C 有副作用的程序（终端、远程桌面、虚拟机），这些程序里只用 UI Automation 取词" Margin="0,0,0,10"/>
                            <StackPanel x:Name="NoClipList"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ComboBox x:Name="NoClipPick" Width="320" DisplayMemberPath="Label" SelectedValuePath="Exe" DropDownOpened="ProcessPick_Opened"/>
                                <Button Content="添加" Margin="8,0,0,0" Click="AddNoClip_Click"/>
                                <Button Content="浏览 exe…" Margin="8,0,0,0" Click="BrowseNoClip_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Actions ===== -->
                <StackPanel x:Name="PanelActions" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="恢复默认" Click="ResetActions_Click" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource AccentButton}" Content="＋ 添加动作" Click="AddAction_Click"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource H1}" Text="动作" Margin="0"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="4,0,0,12" Text="按钮按此顺序显示在悬浮条上。带显示条件的动作只在选中内容匹配时出现；插件提供的动作在「插件」页配置。"/>

                    <ListBox x:Name="ActionsList" Style="{StaticResource PlainList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                            <ui:IconImage Icon="{Binding Def.Icon}" Size="18" Brush="{DynamicResource AccentHoverBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                            <Button Style="{StaticResource IconButton}" ToolTip="上移" Click="MoveUp_Click">
                                                <ui:IconImage Icon="arrow-up" Size="14" Brush="{DynamicResource MutedBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" ToolTip="下移" Click="MoveDown_Click">
                                                <ui:IconImage Icon="arrow-down" Size="14" Brush="{DynamicResource MutedBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" ToolTip="编辑" Click="EditAction_Click" Visibility="{Binding EditVisibility}">
                                                <ui:IconImage Icon="pencil" Size="14" Brush="{DynamicResource MutedBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" ToolTip="删除" Click="DeleteAction_Click">
                                                <ui:IconImage Icon="trash" Size="14" Brush="{DynamicResource DangerBrush}"/>
                                            </Button>
                                        </StackPanel>
                                        <CheckBox Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- ===== Plugins ===== -->
                <StackPanel x:Name="PanelPlugins" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="插件"/>

                    <TextBlock Style="{StaticResource H2}" Text="AI 模型服务（翻译的 AI 模式、AI 助手共用）" Margin="4,0,0,8"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="协议"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="Anthropic 走官方 SDK；OpenAI 兼容可接 LiteLLM、Ollama、DeepSeek 等任何 /chat/completions 接口"/>
                                </StackPanel>
                                <ComboBox x:Name="LlmProtocolCombo" Grid.Column="1" Width="220" VerticalAlignment="Center"
                                          DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Llm_Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="接口地址"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="Anthropic 留空即官方；OpenAI 兼容填到 /v1 为止，如 http://localhost:4000/v1"/>
                                </StackPanel>
                                <TextBox x:Name="LlmBaseUrlBox" Grid.Column="1" Width="330" VerticalAlignment="Center" TextChanged="Llm_Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="API Key" VerticalAlignment="Center"/>
                                <PasswordBox x:Name="LlmKeyBox" Grid.Column="1" Width="330" VerticalAlignment="Center" PasswordChanged="Llm_Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="模型"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="可直接输入，或点「获取模型」从接口拉取列表后选择"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox x:Name="LlmModelBox" Width="236" IsEditable="True" SelectionChanged="Llm_Changed"/>
                                    <Button Content="获取模型" Margin="8,0,0,0" Click="FetchModels_Click"/>
                                </StackPanel>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LlmTestResult" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,8,12,8"/>
                                <Button Grid.Column="1" Content="测试连接" VerticalAlignment="Center" Click="LlmTest_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource H2}" Text="已安装的插件"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="4,0,0,10" x:Name="PluginDirText"/>
                    <StackPanel x:Name="PluginList"/>
                </StackPanel>

                <!-- ===== About ===== -->
                <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="关于"/>
                    <Border Style="{StaticResource Card}" Padding="20,18">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="PopBar"/>
                            <TextBlock x:Name="AboutVersion" Style="{StaticResource Muted}" Margin="0,2,0,12"/>
                            <TextBlock Text="Windows 上的 PopClip：选中文本后立刻弹出操作条。C# / WPF / .NET，不抢焦点，功能以插件组织。" Margin="0,0,0,12"/>
                            <TextBlock>
                                <Run Text="配置文件："/><Hyperlink Click="OpenConfigDir_Click"><Run x:Name="ConfigPathRun"/></Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0">
                                <Run Text="日志："/><Hyperlink Click="OpenLog_Click"><Run x:Name="LogPathRun"/></Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0">
                                <Run Text="源码："/><Hyperlink Click="OpenRepo_Click"><Run Text="github.com/iccyuan/PopBar"/></Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource H2}" Text="使用提示"/>
                    <Border Style="{StaticResource Card}" Padding="20,14">
                        <StackPanel>
                            <TextBlock Margin="0,3" Text="• 拖选、双击或 Shift+点击选中文本后，操作条出现在鼠标附近；点击其他地方、滚轮或按任意键即消失。"/>
                            <TextBlock Margin="0,3" Text="• 网址类动作用 {text} 代表 URL 编码后的选中内容，{raw} 为原文。"/>
                            <TextBlock Margin="0,3" Text="• 翻译 / AI 结果显示在浮动面板，点击面板外关闭，图钉可固定。"/>
                            <TextBlock Margin="0,3" Text="• Ctrl+Alt+O 框选屏幕任意区域做 OCR 取词（可在插件页改热键）。"/>
                            <TextBlock Margin="0,3" Text="• 某些程序（旧版 Win32 控件、部分 Electron 应用）需要剪贴板回退才能取词。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
