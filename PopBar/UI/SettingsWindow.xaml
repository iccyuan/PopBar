<Window x:Class="PopBar.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PopBar.UI"
        Title="PopBar 设置" Icon="{x:Static ui:LogoArt.WindowIcon}" Width="880" Height="660" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Animated">
    <!-- Glass frame over the whole window so Mica shows through; DWM still draws the caption buttons. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- nav (its top 44px doubles as the draggable title area) -->
        <Border Grid.Column="0" Background="{DynamicResource NavBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" RenderOptions.ClearTypeHint="Enabled">
            <DockPanel Margin="12,44,12,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,22">
                    <Image Source="{x:Static ui:LogoArt.Image}" Width="34" Height="34" VerticalAlignment="Center"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PopBar" FontSize="17" FontWeight="Bold"/>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Text="v0.2.0" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Content="通用" Tag="sliders" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavActions" Style="{StaticResource NavItem}" Content="动作" Tag="zap" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" Content="应用" Tag="app-window" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavPlugins" Style="{StaticResource NavItem}" Content="插件" Tag="puzzle" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavServices" Style="{StaticResource NavItem}" Content="服务" Tag="server" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Content="关于" Tag="info" Checked="Nav_Checked"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Style="{StaticResource Muted}" Margin="10,0,0,0" Text=""/>
            </DockPanel>
        </Border>

        <!-- window title drawn by us (DWM only draws the caption buttons when the frame is extended) -->
        <TextBlock Grid.Column="0" Text="PopBar 设置" Style="{StaticResource Muted}" Margin="22,13,0,0" VerticalAlignment="Top" IsHitTestVisible="False"/>

        <!-- content -->
        <!-- Spacing lives on the content, not the ScrollViewer: its padding would clip scrolled cards at a hard line. -->
        <ScrollViewer Grid.Column="1" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" Margin="0,44,0,0">
            <Grid x:Name="ContentRoot" Margin="32,12,32,32">
                <!-- ===== General ===== -->
                <StackPanel x:Name="PanelGeneral">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="启用 PopBar" VerticalAlignment="Center"/>
                                    <ui:InfoTip Text="关闭后不再监听选择，托盘菜单也可切换"/>
                                    </StackPanel>
                                <CheckBox x:Name="EnabledSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="开机自动启动" VerticalAlignment="Center"/>
                                <CheckBox x:Name="AutoStartSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="托盘图标左键" VerticalAlignment="Center"/>
                                    <ui:InfoTip Text="单击托盘图标时执行的动作，可选插件提供的托盘功能（截图、OCR、屏幕翻译…）。双击始终打开设置，右键是菜单。"/>
                                </StackPanel>
                                <ComboBox x:Name="TrayClickCombo" Grid.Column="1" Width="230" VerticalAlignment="Center"
                                          DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource H2}" Text="触发方式"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="显示方式" VerticalAlignment="Center"/>
                                    <ui:InfoTip Text="“按键后显示”：选中时按住该键，或选中后 4 秒内按一下，操作条才出现"/>
                                    </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox x:Name="ShowModeCombo" Width="150" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="ShowMode_Changed"/>
                                    <ui:KeyCaptureBox x:Name="ShowKeyBox" Mode="Single" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="鼠标拖动选择文本" VerticalAlignment="Center"/>
                                <CheckBox x:Name="DragSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="双击 / 三击选中" VerticalAlignment="Center"/>
                                <CheckBox x:Name="DblSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Shift + 点击扩展选择" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ShiftSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource H2}" Text="取词"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="剪贴板回退" VerticalAlignment="Center"/>
                                    <ui:InfoTip Text="UI Automation 读不到选区时，模拟 Ctrl+C 取词并立即恢复剪贴板。终端类程序永远不用此方式。"/>
                                    </StackPanel>
                                <ComboBox x:Name="FallbackCombo" Grid.Column="1" Width="230" VerticalAlignment="Center"
                                          DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="弹出延迟（毫秒）" VerticalAlignment="Center"/>
                                    <ui:InfoTip Text="松开鼠标后等待多久再取词，太小可能取到上一次的选区"/>
                                    </StackPanel>
                                <TextBox x:Name="DelayBox" Width="90" HorizontalAlignment="Right" VerticalAlignment="Center" TextChanged="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="最大文本长度（超过不弹出）" VerticalAlignment="Center"/>
                                <TextBox x:Name="MaxLenBox" Width="90" HorizontalAlignment="Right" VerticalAlignment="Center" TextChanged="Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource H2}" Text="外观"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="主题" VerticalAlignment="Center"/>
                                    <ui:InfoTip Text="作用于操作条、面板和本窗口；跟随系统时随 Windows 深浅色实时切换"/>
                                    </StackPanel>
                                <ComboBox x:Name="ThemeCombo" Width="160" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Instant_Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="按钮显示文字标签" VerticalAlignment="Center"/>
                                <CheckBox x:Name="LabelsSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Instant_Changed" Unchecked="Instant_Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="最多显示按钮数" VerticalAlignment="Center"/>
                                    <ui:InfoTip Text="超出的按钮折叠到操作条末尾的「更多」里，点开后在原位展开"/>
                                </StackPanel>
                                <ComboBox x:Name="MaxItemsCombo" Width="160" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Instant_Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="毛玻璃不透明度" VerticalAlignment="Center"/>
                                    <ui:InfoTip Text="操作条和面板底色的实度，越低越透、越容易发灰"/>
                                    </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="BlurSlider" Width="180" Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="BlurSlider_ValueChanged"/>
                                    <TextBlock x:Name="BlurValueText" Width="40" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ===== Apps ===== -->
                <StackPanel x:Name="PanelApps" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Muted}" Margin="4,0,0,12" Text="从运行中的程序里选，或浏览 exe 文件。"/>

                    <TextBlock Style="{StaticResource H2}" Text="排除的应用" Margin="4,0,0,8"/>
                    <Border Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Text="这些程序里不弹出操作条。" Margin="0,0,0,10"/>
                            <StackPanel x:Name="ExcludedList"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ComboBox x:Name="ExcludedPick" Width="320" DisplayMemberPath="Label" SelectedValuePath="Exe" DropDownOpened="ProcessPick_Opened"/>
                                <Button Content="添加" Margin="8,0,0,0" Click="AddExcluded_Click"/>
                                <Button Content="浏览 exe…" Margin="8,0,0,0" Click="BrowseExcluded_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource H2}" Text="禁用剪贴板回退的应用"/>
                    <Border Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Text="这些程序里不用 Ctrl+C 取词（终端、远程桌面等）。" Margin="0,0,0,10"/>
                            <StackPanel x:Name="NoClipList"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ComboBox x:Name="NoClipPick" Width="320" DisplayMemberPath="Label" SelectedValuePath="Exe" DropDownOpened="ProcessPick_Opened"/>
                                <Button Content="添加" Margin="8,0,0,0" Click="AddNoClip_Click"/>
                                <Button Content="浏览 exe…" Margin="8,0,0,0" Click="BrowseNoClip_Click"/>
                                <Button Content="恢复默认" Margin="8,0,0,0" Click="ResetNoClip_Click" ToolTip="恢复为内置的终端 / 远程桌面 / 虚拟机列表"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Actions ===== -->
                <StackPanel x:Name="PanelActions" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Content="恢复默认" Click="ResetActions_Click" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource AccentButton}" Content="＋ 添加动作" Click="AddAction_Click"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="4,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Text="按此顺序显示在操作条上，按住左侧手柄拖动排序。同一插件的多个动作归在一组，整组拖动，组内也可调整顺序。"/>
                    </DockPanel>

                    <ListBox x:Name="ActionsList" Style="{StaticResource PlainList}" AllowDrop="True" DragOver="ActionsList_DragOver" Drop="ActionsList_Drop">
                        <ListBox.Resources>
                            <BooleanToVisibilityConverter x:Key="BoolVis"/>
                            <!-- a stand-alone action -->
                            <DataTemplate DataType="{x:Type ui:ActionRow}">
                                <Border Style="{StaticResource Card}" Padding="6,10,14,10" Opacity="{Binding DragOpacity}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="24" Height="36" Background="Transparent" Cursor="SizeAll" ToolTip="拖动排序" VerticalAlignment="Center" Margin="0,0,6,0" PreviewMouseLeftButtonDown="DragHandle_MouseDown">
                                            <ui:IconImage Icon="grip-vertical" Size="16" Brush="{DynamicResource MutedBrush}"/>
                                        </Border>
                                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                            <ui:IconImage Icon="{Binding Def.Icon}" Size="18" Brush="{DynamicResource AccentHoverBrush}"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="14"/>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                            <Button Style="{StaticResource IconButton}" ToolTip="编辑" Click="EditAction_Click" Visibility="{Binding EditVisibility}">
                                                <ui:IconImage Icon="pencil" Size="14" Brush="{DynamicResource MutedBrush}"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" ToolTip="删除" Click="DeleteAction_Click">
                                                <ui:IconImage Icon="trash" Size="14" Brush="{DynamicResource DangerBrush}"/>
                                            </Button>
                                        </StackPanel>
                                        <CheckBox Grid.Column="4" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>

                            <!-- several actions of one plugin: one card, plugin header, members hanging off a guide line -->
                            <DataTemplate DataType="{x:Type ui:ActionGroupRow}">
                                <Border Style="{StaticResource Card}" Padding="6,10,14,8" Opacity="{Binding DragOpacity}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="24" Height="36" Background="Transparent" Cursor="SizeAll" ToolTip="拖动整组排序" VerticalAlignment="Center" Margin="0,0,6,0" PreviewMouseLeftButtonDown="DragHandle_MouseDown">
                                                <ui:IconImage Icon="grip-vertical" Size="16" Brush="{DynamicResource MutedBrush}"/>
                                            </Border>
                                            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                                                <ui:IconImage Icon="{Binding Icon}" Size="18" Brush="White"/>
                                            </Border>
                                            <!-- the whole title area folds / unfolds the group, like the chevron -->
                                            <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="GroupToggle_Click">
                                                <TextBlock Text="{Binding Name}" FontSize="14"/>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                            <Border Grid.Column="3" CornerRadius="10" Padding="9,2,9,3" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource AccentHoverBrush}"/>
                                            </Border>
                                            <Button Grid.Column="4" Style="{StaticResource IconButton}" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="收起 / 展开" Click="GroupToggle_Click">
                                                <ui:IconImage Icon="{Binding ChevronIcon}" Size="16" Brush="{DynamicResource MutedBrush}"/>
                                            </Button>
                                        </Grid>
                                        <!-- guide line under the plugin icon ties the members to it -->
                                        <Border Margin="47,6,0,0" BorderThickness="2,0,0,0" BorderBrush="{DynamicResource AccentSoftBrush}"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                                            <ItemsControl ItemsSource="{Binding Members}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4,0,4" Opacity="{Binding DragOpacity}" Background="Transparent">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle Grid.Column="0" Width="12" Height="2" Fill="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center"/>
                                                            <Border Grid.Column="1" Width="20" Height="32" Background="Transparent" Cursor="SizeAll" ToolTip="在组内拖动排序" VerticalAlignment="Center" Margin="2,0,2,0" PreviewMouseLeftButtonDown="DragHandle_MouseDown">
                                                                <ui:IconImage Icon="grip-vertical" Size="14" Brush="{DynamicResource MutedBrush}"/>
                                                            </Border>
                                                            <Border Grid.Column="2" Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                                                <ui:IconImage Icon="{Binding Def.Icon}" Size="15" Brush="{DynamicResource AccentHoverBrush}"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Label}"/>
                                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="4" Style="{StaticResource IconButton}" ToolTip="删除" Click="DeleteAction_Click" VerticalAlignment="Center" Margin="8,0">
                                                                <ui:IconImage Icon="trash" Size="14" Brush="{DynamicResource DangerBrush}"/>
                                                            </Button>
                                                            <CheckBox Grid.Column="5" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>
                </StackPanel>

                <!-- ===== Plugins ===== -->
                <StackPanel x:Name="PanelPlugins" Visibility="Collapsed">

                    <TextBlock Style="{StaticResource H2}" Text="已安装的插件"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="4,0,0,10" x:Name="PluginDirText"/>
                    <StackPanel x:Name="PluginList"/>
                </StackPanel>

                <!-- ===== Services: capabilities shared by plugins ===== -->
                <StackPanel x:Name="PanelServices" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Muted}" Margin="4,0,0,16" TextWrapping="Wrap" Text="多个功能共用的服务：在这里配置一次，用到它的功能都会使用。"/>

                    <TextBlock Style="{StaticResource H2}" Text="AI 模型" Margin="4,0,0,2"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="4,0,0,6" Text="插件通过它调用大模型；当前协议支持："/>
                    <WrapPanel x:Name="LlmFeatureChips" Margin="4,0,0,10"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="协议" VerticalAlignment="Center"/>
                                    <ui:InfoTip Text="Anthropic 走官方 SDK；OpenAI 兼容可接 LiteLLM、Ollama、DeepSeek 等任何 /chat/completions 接口"/>
                                    </StackPanel>
                                <ComboBox x:Name="LlmProtocolCombo" Grid.Column="1" Width="220" VerticalAlignment="Center"
                                          DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Llm_Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="接口地址" VerticalAlignment="Center"/>
                                    <ui:InfoTip Text="Anthropic 留空即官方；OpenAI 兼容填到 /v1 为止，如 http://localhost:4000/v1"/>
                                    </StackPanel>
                                <TextBox x:Name="LlmBaseUrlBox" Grid.Column="1" Width="330" VerticalAlignment="Center" TextChanged="Llm_Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="API Key" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- masked by default; the eye swaps in a plain TextBox bound to the same value -->
                                    <Grid Width="290">
                                        <PasswordBox x:Name="LlmKeyBox" PasswordChanged="Llm_Changed"/>
                                        <TextBox x:Name="LlmKeyPlain" Visibility="Collapsed" TextChanged="LlmKeyPlain_TextChanged"/>
                                    </Grid>
                                    <Button x:Name="LlmKeyEye" Style="{StaticResource IconButton}" Width="34" Height="34" Margin="6,0,0,0" ToolTip="显示 API Key" Click="LlmKeyEye_Click">
                                        <ui:IconImage x:Name="LlmKeyEyeIcon" Icon="eye" Size="16" Brush="{DynamicResource MutedBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="默认模型" VerticalAlignment="Center"/>
                                    <ui:InfoTip Text="可直接输入，或点「获取模型」从接口拉取列表后选择。这是默认值，各插件（AI 助手、翻译…）的设置里可以单独指定自己的模型。"/>
                                    </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox x:Name="LlmModelBox" Width="236" IsEditable="True" SelectionChanged="Llm_Changed"/>
                                    <Button Content="获取模型" Margin="8,0,0,0" Click="FetchModels_Click"/>
                                </StackPanel>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LlmTestResult" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,8,12,8" TextWrapping="Wrap"/>
                                <Button Grid.Column="1" Content="测试连接" VerticalAlignment="Center" Click="LlmTest_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>


                </StackPanel>

                <!-- ===== About ===== -->
                <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="20,18">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="PopBar"/>
                            <TextBlock x:Name="AboutVersion" Style="{StaticResource Muted}" Margin="0,2,0,12"/>
                            <TextBlock Text="Windows 上的 PopClip：选中文本后立刻弹出操作条。C# / WPF / .NET，不抢焦点，功能以插件组织。" Margin="0,0,0,12"/>
                            <TextBlock>
                                <Run Text="配置文件："/><Hyperlink Click="OpenConfigDir_Click"><Run x:Name="ConfigPathRun"/></Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0">
                                <Run Text="日志："/><Hyperlink Click="OpenLog_Click"><Run x:Name="LogPathRun"/></Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0">
                                <Run Text="源码："/><Hyperlink Click="OpenRepo_Click"><Run Text="github.com/iccyuan/PopBar"/></Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource H2}" Text="使用提示"/>
                    <Border Style="{StaticResource Card}" Padding="20,14">
                        <StackPanel>
                            <TextBlock Margin="0,3" Text="• 拖选、双击或 Shift+点击选中文本后，操作条出现在鼠标附近；点击其他地方、滚轮或按任意键即消失。"/>
                            <TextBlock Margin="0,3" Text="• 网址类动作用 {text} 代表 URL 编码后的选中内容，{raw} 为原文。"/>
                            <TextBlock Margin="0,3" Text="• 翻译 / AI 结果显示在浮动面板，点击面板外关闭，图钉可固定。"/>
                            <TextBlock Margin="0,3" Text="• Ctrl+Alt+O 框选屏幕任意区域做 OCR 取词（可在插件页改热键）。"/>
                            <TextBlock Margin="0,3" Text="• 某些程序（旧版 Win32 控件、部分 Electron 应用）需要剪贴板回退才能取词。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- unsaved-changes bar: nothing is written until the user saves -->
        <Border x:Name="SaveBar" Grid.Column="1" VerticalAlignment="Bottom" Margin="32,0,40,20" Padding="18,10,10,10" CornerRadius="14"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                RenderOptions.ClearTypeHint="Enabled" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.1"/>
            </Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="取消" Click="CancelChanges_Click" ToolTip="放弃改动，恢复到上次保存"/>
                    <Button Style="{StaticResource AccentButton}" Content="保存" Margin="8,0,0,0" Click="SaveChanges_Click" ToolTip="Ctrl+S"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="有未保存的更改" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
