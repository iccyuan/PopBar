<Window x:Class="PopBar.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PopBar.UI"
        Title="PopBar 设置" Width="860" Height="640" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- nav -->
        <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,18">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,18">
                    <TextBlock Text="PopBar" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Text="v0.1.0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Content="通用" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavActions" Style="{StaticResource NavItem}" Content="动作" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavPlugins" Style="{StaticResource NavItem}" Content="插件" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Content="关于" Checked="Nav_Checked"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Style="{StaticResource Muted}" Margin="8,0,0,0" Text=""/>
            </DockPanel>
        </Border>

        <!-- content -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,22,28,28">
            <Grid>
                <!-- ===== General ===== -->
                <StackPanel x:Name="PanelGeneral">
                    <TextBlock Style="{StaticResource H1}" Text="通用"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="启用 PopBar"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="关闭后不再监听选择，托盘菜单也可切换"/>
                                </StackPanel>
                                <CheckBox x:Name="EnabledSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="开机自动启动" VerticalAlignment="Center"/>
                                <CheckBox x:Name="AutoStartSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource H2}" Text="触发方式"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="鼠标拖动选择文本" VerticalAlignment="Center"/>
                                <CheckBox x:Name="DragSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="双击 / 三击选中" VerticalAlignment="Center"/>
                                <CheckBox x:Name="DblSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="Shift + 点击扩展选择" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ShiftSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource H2}" Text="取词"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,8">
                                    <TextBlock Text="剪贴板回退"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="UI Automation 读不到选区时，模拟 Ctrl+C 取词并立即恢复剪贴板。终端类程序永远不用此方式。"/>
                                </StackPanel>
                                <ComboBox x:Name="FallbackCombo" Grid.Column="1" Width="230" VerticalAlignment="Center" Margin="12,0,0,0"
                                          DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="弹出延迟（毫秒）"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="松开鼠标后等待多久再取词，太小可能取到上一次的选区"/>
                                </StackPanel>
                                <TextBox x:Name="DelayBox" Width="90" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" TextChanged="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="最大文本长度（超过不弹出）" VerticalAlignment="Center"/>
                                <TextBox x:Name="MaxLenBox" Width="90" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" TextChanged="Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource H2}" Text="外观"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="主题" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ThemeCombo" Width="140" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock Text="按钮显示文字标签" VerticalAlignment="Center"/>
                                <CheckBox x:Name="LabelsSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource H2}" Text="应用例外"/>
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="排除的应用（每行一个进程名，如 game.exe，PopBar 在这些程序里完全不弹出）"/>
                            <TextBox x:Name="ExcludedBox" Margin="0,8,0,14" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextChanged="Changed"/>
                            <TextBlock Text="禁用剪贴板回退的应用（Ctrl+C 有副作用的程序，如终端、远程桌面）"/>
                            <TextBox x:Name="NoClipBox" Margin="0,8,0,4" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextChanged="Changed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Actions ===== -->
                <StackPanel x:Name="PanelActions" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="恢复默认" Click="ResetActions_Click" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource AccentButton}" Content="＋ 添加动作" Click="AddAction_Click"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource H1}" Text="动作" Margin="0"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="4,0,0,12" Text="按钮按此顺序显示在悬浮条上。带显示条件的动作只在选中内容匹配时出现。"/>

                    <ListBox x:Name="ActionsList" Style="{StaticResource PlainList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Canvas.LayoutTransform>
                                                    <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                                                </Canvas.LayoutTransform>
                                                <Path Data="{Binding IconGeometry}" Stroke="{StaticResource AccentHoverBrush}" StrokeThickness="2"
                                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Canvas>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                            <Button Style="{StaticResource IconButton}" ToolTip="上移" Click="MoveUp_Click">
                                                <Path Data="{x:Static ui:Icons.ArrowUp}" Stroke="{StaticResource MutedBrush}" StrokeThickness="2" Stretch="Uniform" Width="14" Height="14" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" ToolTip="下移" Click="MoveDown_Click">
                                                <Path Data="{x:Static ui:Icons.ArrowDown}" Stroke="{StaticResource MutedBrush}" StrokeThickness="2" Stretch="Uniform" Width="14" Height="14" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" ToolTip="编辑" Click="EditAction_Click">
                                                <Path Data="{x:Static ui:Icons.Pencil}" Stroke="{StaticResource MutedBrush}" StrokeThickness="2" Stretch="Uniform" Width="14" Height="14" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" ToolTip="删除" Click="DeleteAction_Click">
                                                <Path Data="{x:Static ui:Icons.Trash}" Stroke="{StaticResource DangerBrush}" StrokeThickness="2" Stretch="Uniform" Width="14" Height="14" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Button>
                                        </StackPanel>
                                        <CheckBox Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <!-- ===== Plugins ===== -->
                <StackPanel x:Name="PanelPlugins" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="插件"/>

                    <TextBlock Style="{StaticResource H2}" Text="AI 模型服务（翻译的 AI 模式、AI 助手共用）" Margin="4,0,0,8"/>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="协议"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="Anthropic 走官方 SDK；OpenAI 兼容可接 LiteLLM、Ollama、DeepSeek 等任何 /chat/completions 接口"/>
                                </StackPanel>
                                <ComboBox x:Name="LlmProtocolCombo" Grid.Column="1" Width="220" VerticalAlignment="Center"
                                          DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="Llm_Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="接口地址"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="Anthropic 留空即官方；OpenAI 兼容填到 /v1 为止，如 http://localhost:4000/v1"/>
                                </StackPanel>
                                <TextBox x:Name="LlmBaseUrlBox" Grid.Column="1" Width="320" Height="34" VerticalAlignment="Center" TextChanged="Llm_Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="API Key" VerticalAlignment="Center"/>
                                <PasswordBox x:Name="LlmKeyBox" Grid.Column="1" Width="320" Height="34" VerticalAlignment="Center" Padding="8,0" VerticalContentAlignment="Center" PasswordChanged="Llm_Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,8,12,8">
                                    <TextBlock Text="模型"/>
                                    <TextBlock Style="{StaticResource Muted}" Text="Anthropic 默认 claude-opus-5-5；OpenAI 兼容填服务端的模型名"/>
                                </StackPanel>
                                <TextBox x:Name="LlmModelBox" Grid.Column="1" Width="320" Height="34" VerticalAlignment="Center" TextChanged="Llm_Changed"/>
                            </Grid>
                            <Rectangle Style="{StaticResource RowSep}"/>
                            <Grid Style="{StaticResource Row}">
                                <TextBlock x:Name="LlmTestResult" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,120,0"/>
                                <Button Content="测试连接" HorizontalAlignment="Right" VerticalAlignment="Center" Click="LlmTest_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource H2}" Text="已安装的插件"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="4,0,0,10" x:Name="PluginDirText"/>
                    <StackPanel x:Name="PluginList"/>
                </StackPanel>

                <!-- ===== About ===== -->
                <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource H1}" Text="关于"/>
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="PopBar"/>
                            <TextBlock x:Name="AboutVersion" Style="{StaticResource Muted}" Margin="0,2,0,12"/>
                            <TextBlock Text="Windows 上的 PopClip：选中文本后立刻弹出操作条。C# / WPF / .NET，零依赖常驻，不抢焦点。" Margin="0,0,0,12"/>
                            <TextBlock>
                                <Run Text="配置文件："/><Hyperlink Click="OpenConfigDir_Click"><Run x:Name="ConfigPathRun"/></Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0,4,0,0">
                                <Run Text="日志："/><Hyperlink Click="OpenLog_Click"><Run x:Name="LogPathRun"/></Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource H2}" Text="使用提示"/>
                    <Border Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <TextBlock Margin="0,3" Text="• 拖选、双击或 Shift+点击选中文本后，操作条出现在鼠标附近；点击其他地方、滚轮或按任意键即消失。"/>
                            <TextBlock Margin="0,3" Text="• 网址类动作用 {text} 代表 URL 编码后的选中内容，{raw} 为原文。"/>
                            <TextBlock Margin="0,3" Text="• “转换”类动作会把结果粘贴回原处替换选区，粘贴后自动还原剪贴板。"/>
                            <TextBlock Margin="0,3" Text="• 某些程序（旧版 Win32 控件、部分 Electron 应用）需要剪贴板回退才能取词。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
