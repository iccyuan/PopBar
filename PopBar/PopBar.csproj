<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 gives us Windows.Media.Ocr (built-in offline OCR) through CsWinRT. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PopBar</AssemblyName>
    <RootNamespace>PopBar</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\popbar.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PopBar.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PopBar.Sdk\PopBar.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The built-in plugins (plugins/): separate assemblies that only know PopBar.Sdk; the app just ships them. -->
    <ProjectReference Include="..\plugins\Translate\PopBar.Plugins.Translate.csproj" />
    <ProjectReference Include="..\plugins\Ai\PopBar.Plugins.Ai.csproj" />
    <ProjectReference Include="..\plugins\Ocr\PopBar.Plugins.Ocr.csproj" />
    <ProjectReference Include="..\plugins\Screenshot\PopBar.Plugins.Screenshot.csproj" />
    <ProjectReference Include="..\plugins\SendTo\PopBar.Plugins.SendTo.csproj" />
    <ProjectReference Include="..\plugins\Qr\PopBar.Plugins.Qr.csproj" />
    <ProjectReference Include="..\plugins\Codec\PopBar.Plugins.Codec.csproj" />
    <ProjectReference Include="..\plugins\Notes\PopBar.Plugins.Notes.csproj" />
    <ProjectReference Include="..\plugins\ScreenTranslate\PopBar.Plugins.ScreenTranslate.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- COM interop for IUIAutomation (same assembly FlaUI.UIA3 uses). -->
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <!-- Official Anthropic SDK for the "anthropic" LLM protocol. -->
    <PackageReference Include="Anthropic" Version="12.55.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\popbar.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its global usings out of WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
