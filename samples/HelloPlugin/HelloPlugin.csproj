<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Minimal third-party PopBar plugin.
    Build:   dotnet build -c Release
    Install: copy bin\Release\net10.0-windows\HelloPlugin.dll to %AppData%\PopBar\plugins\hello\
    Only PopBar.Sdk is shared with the host; any other dependency must ship next to your DLL.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PopBar.Sdk\PopBar.Sdk.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
